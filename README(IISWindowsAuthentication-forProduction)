private Optional<Employee> resolveFromHeader(HttpServletRequest httpRequest) {
    String remoteUser = httpRequest.getHeader("X-Remote-User");
    if (remoteUser == null || remoteUser.isBlank()) return Optional.empty();
    int backslash = remoteUser.indexOf('\\');
    String username = backslash >= 0 ? remoteUser.substring(backslash + 1) : remoteUser;
    return employeeService.findByCode(username);
}
